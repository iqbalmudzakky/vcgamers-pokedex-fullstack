    {
      "name": "Pokemon Detail",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/pokemon/:name",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "pokemon",
            ":name"
          ],
          "variable": [
            {
              "key": "name",
              "value": "bulbasaur"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "pm.test('Detail has required fields', function () {",
              "  pm.expect(json.data).to.have.property('sprites');",
              "  pm.expect(json.data).to.have.property('types');",
              "  pm.expect(json.data).to.have.property('moves');",
              "  pm.expect(json.data).to.have.property('evolutionChain');",
              "});",
              "",
              "pm.test('Moves max 10', function () {",
              "  pm.expect(json.data.moves.length).to.be.at.most(10);",
              "});"
            ]
          }
        }
      ]
    },
